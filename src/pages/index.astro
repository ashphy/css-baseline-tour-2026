---
import BaseLayout from '../layouts/BaseLayout.astro';
import { features, url } from '../features';
---

<BaseLayout title="CSS Baseline Tour 2026">
	<main>
		<header>
			<p class="eyebrow">Talk</p>
			<h1>CSS Baseline Tour 2026</h1>
			<p class="lead">2025年以降にBaselineになったCSSの機能と、もうすぐ使えそうな機能を、触りながら紹介します。</p>
		</header>
		<ol>
			{
				features.map((f, i) => (
					<li>
						<a href={url(f.slug)}>
							<span class="step">STEP {i + 1}</span>
							<span class="title">{f.title}</span>
							<span class="summary">{f.summary}</span>
							<small>{f.status}</small>
						</a>
					</li>
				))
			}
		</ol>
	</main>
</BaseLayout>

<style>
	main {
		display: grid;
		gap: 40px;
		max-width: 760px;
		margin: 0 auto;
		padding: 64px 16px;
	}

	header {
		display: grid;
		gap: 12px;
	}

	.eyebrow {
		margin: 0;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: 2.6rem;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.lead {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.8;
	}

	/* 目次と同じ路線図。各機能を停留所として縦の線でつなぐ */
	ol {
		position: relative;
		display: grid;
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	ol::before {
		content: '';
		position: absolute;
		top: 22px;
		bottom: 22px;
		left: 13px;
		width: 3px;
		background: var(--color-accent);
	}

	li a {
		position: relative;
		display: grid;
		gap: 2px;
		padding: 12px 16px 12px 44px;
		border-radius: var(--radius);
		color: var(--color-text);
		text-decoration: none;
	}

	li a::before {
		content: '';
		position: absolute;
		top: 16px;
		left: 6px;
		width: 17px;
		height: 17px;
		border: 4px solid var(--color-accent);
		border-radius: 50%;
		background: var(--color-surface);
	}

	li a:hover {
		background: var(--color-surface);
	}

	li a:hover::before {
		background: var(--color-accent);
	}

	.step {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
	}

	.title {
		font-size: 1.15rem;
		font-weight: 700;
	}

	.summary {
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	small {
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}
</style>
